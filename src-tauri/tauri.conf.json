{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brasa",
  "version": "0.1.0",
  "identifier": "com.brasa.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Brasa",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "category": "Education",
    "shortDescription": "Lector personal de EPUB y PDF",
    "longDescription": "Brasa lee tus libros EPUB y PDF en Windows y Linux. Todo se guarda en tu equipo.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
